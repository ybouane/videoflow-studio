{
  "name": "@videoflow/studio",
  "version": "1.0.3",
  "description": "Turn a product URL into a finished launch video. An AI agent harness that plans, writes, renders and reviews a trailer for your website, from the command line.",
  "keywords": [
    "video",
    "trailer",
    "launch-video",
    "promo-video",
    "product-video",
    "motion-graphics",
    "animation",
    "video-generator",
    "ai",
    "ai-agent",
    "agentic",
    "cli",
    "automation",
    "videoflow",
    "video-editing",
    "ffmpeg",
    "headless"
  ],
  "bin": {
    "studio": "./dist/cli.js",
    "videoflow": "./dist/cli.js"
  },
  "scripts": {
    "prepublishOnly": "node -e \"const f=require('fs');for(const m of ['site','cli','content','admin','PUBLISHING.md'])if(f.existsSync(m)){console.error('\\n  refusing to publish: '+m+' is here, so this is the monorepo and not the package\\n');process.exit(1)}\""
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "src/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@clack/prompts": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.153.4",
    "@videoflow/core": "^1.3.4",
    "@videoflow/renderer-browser": "^1.3.4",
    "@videoflow/renderer-dom": "^1.3.4",
    "@videoflow/renderer-server": "^1.3.4",
    "@ybouane/dash-p": "^2.1.268",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "liquidjs": "^10.16.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.59.0",
    "zod": "^4.0.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "VideoFlow <hello@videoflow.dev> (https://videoflow.dev)",
  "homepage": "https://studio.videoflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ybouane/videoflow-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ybouane/videoflow-studio/issues",
    "email": "hello@videoflow.dev"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
